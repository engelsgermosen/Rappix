<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Rappix.Catalog.Api</RootNamespace>
    <AssemblyName>Rappix.Catalog.Api</AssemblyName>
    <!-- El generador de comentarios XML de OpenAPI (.NET 10) usa interceptores de C#. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- Servidor gRPC propio (CatalogValidationService). GrpcServices=Both para que las pruebas usen el cliente generado sobre el TestServer. -->
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Both" />
    <!-- Servicio de reserva de stock (consumido por la saga de Orders). Both para usar el cliente en pruebas. -->
    <Protobuf Include="Protos\stock-reservation.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rappix.Catalog.Application\Rappix.Catalog.Application.csproj" />
    <ProjectReference Include="..\Rappix.Catalog.Infrastructure\Rappix.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.WebApi\Rappix.BuildingBlocks.WebApi.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Observability\Rappix.BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Messaging\Rappix.BuildingBlocks.Messaging.csproj" />
  </ItemGroup>

</Project>
