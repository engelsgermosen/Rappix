<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rappix.Catalog.Infrastructure</RootNamespace>
    <AssemblyName>Rappix.Catalog.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite a las pruebas instanciar tipos internos (repositorios, consumers). -->
    <InternalsVisibleTo Include="Rappix.Catalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <!-- Cliente gRPC del servicio Merchants (validacion de comercio) con resiliencia (retry + circuit breaker). -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia client-only del contrato de Merchants para el cliente gRPC (csharp_namespace propio). -->
    <Protobuf Include="Protos\merchants.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rappix.Catalog.Application\Rappix.Catalog.Application.csproj" />
    <ProjectReference Include="..\Rappix.Catalog.Domain\Rappix.Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\..\Contracts\Rappix.Contracts\Rappix.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Core\Rappix.BuildingBlocks.Core.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Messaging\Rappix.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Storage\Rappix.BuildingBlocks.Storage.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Rappix.BuildingBlocks.Imaging\Rappix.BuildingBlocks.Imaging.csproj" />
  </ItemGroup>

</Project>
