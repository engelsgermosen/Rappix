{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Seq": {
    "ServerUrl": "http://seq:80"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "identity":      { "Destinations": { "default": { "Address": "http://identity-api:8080/"      } } },
      "merchants":     { "Destinations": { "default": { "Address": "http://merchants-api:8080/"     } } },
      "catalog":       { "Destinations": { "default": { "Address": "http://catalog-api:8080/"       } } },
      "pricing":       { "Destinations": { "default": { "Address": "http://pricing-api:8080/"       } } },
      "orders":        { "Destinations": { "default": { "Address": "http://orders-api:8080/"        } } },
      "dispatch":      { "Destinations": { "default": { "Address": "http://dispatch-api:8080/"      } } },
      "tracking":      { "Destinations": { "default": { "Address": "http://tracking-api:8080/"      } } },
      "payments":      { "Destinations": { "default": { "Address": "http://payments-api:8080/"      } } },
      "notifications": { "Destinations": { "default": { "Address": "http://notifications-api:8080/" } } }
    }
  }
}
