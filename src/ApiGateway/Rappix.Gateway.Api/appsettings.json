{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "rappix",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-me-authn": {
        "ClusterId": "identity",
        "Order": -10,
        "Match": { "Path": "/api/v1/auth/me" }
      },
      "identity-auth-public": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "merchants-admin": {
        "ClusterId": "merchants",
        "Match": { "Path": "/api/v1/admin/merchants/{**catch-all}" }
      },
      "merchants-public": {
        "ClusterId": "merchants",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/v1/merchants/{**catch-all}" }
      },
      "catalog-me": {
        "ClusterId": "catalog",
        "Order": -10,
        "Match": { "Path": "/api/v1/catalog/me/{**catch-all}" }
      },
      "catalog-public": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}" }
      },
      "pricing-admin": {
        "ClusterId": "pricing",
        "Match": { "Path": "/api/v1/admin/pricing/{**catch-all}" }
      },
      "pricing": {
        "ClusterId": "pricing",
        "Match": { "Path": "/api/v1/pricing/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },
      "dispatch-couriers": {
        "ClusterId": "dispatch",
        "Match": { "Path": "/api/v1/couriers/{**catch-all}" }
      },
      "tracking-rest": {
        "ClusterId": "tracking",
        "Match": { "Path": "/api/v1/tracking/{**catch-all}" }
      },
      "tracking-hub": {
        "ClusterId": "tracking",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/hubs/tracking/{**catch-all}" }
      },
      "payments-rest": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "payments-webhook-stripe": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/payments/webhooks/stripe",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "default": { "Address": "http://localhost:5001/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "merchants": {
        "Destinations": { "default": { "Address": "http://localhost:5002/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "catalog": {
        "Destinations": { "default": { "Address": "http://localhost:5003/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "pricing": {
        "Destinations": { "default": { "Address": "http://localhost:5004/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "orders": {
        "Destinations": { "default": { "Address": "http://localhost:5005/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "dispatch": {
        "Destinations": { "default": { "Address": "http://localhost:5006/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "tracking": {
        "Destinations": { "default": { "Address": "http://localhost:5007/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "payments": {
        "Destinations": { "default": { "Address": "http://localhost:5008/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      },
      "notifications": {
        "Destinations": { "default": { "Address": "http://localhost:5009/" } },
        "HttpRequest": { "Version": "1.1", "VersionPolicy": "RequestVersionExact" }
      }
    }
  }
}
