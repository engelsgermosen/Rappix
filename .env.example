# ============================================================
# Rappix Identity — variables de entorno
# Copia este archivo a .env y completa los valores.
#   cp .env.example .env   (o copy en Windows)
# .env esta en .gitignore: nunca se commitea.
# ============================================================

# --- JWT ---
# Clave simetrica HS256 de >= 256 bits (32+ caracteres).
# Genera una:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
#   bash:        openssl rand -base64 48
IDENTITY_JWT_SIGNINGKEY=

# --- SendGrid (email de confirmacion) ---
# API key:                 https://app.sendgrid.com/settings/api_keys
# Single Sender Verification: https://app.sendgrid.com/settings/sender_auth/senders
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@rappix.local
SENDGRID_FROM_NAME=Rappix

# --- Google OAuth ---
# Credenciales: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada (debe coincidir EXACTO):
#   http://localhost:5001/signin-google   (docker compose, http)
#   https://localhost:5001/signin-google  (dotnet run, https)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Fase 8) ---
# Selector de gateway de pago. Default Fake (in-process, smoke E2E sin Stripe ni Stripe CLI).
# Cambiar a "Stripe" para usar Stripe real (requiere las 2 claves siguientes).
# PAYMENTS_GATEWAY=Stripe
#
# Solo si PAYMENTS_GATEWAY=Stripe. Test mode: claves "sk_test_..." y "whsec_..." del dashboard.
#   API key:        https://dashboard.stripe.com/test/apikeys
#   Webhook secret: salida de `stripe listen --forward-to localhost:5008/api/v1/payments/webhooks/stripe`
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications (Fase 9) ---
# Selector de canal de envio. Default Fake (in-process, log-only en Seq, smoke E2E sin SendGrid).
# Cambiar a "SendGrid" para enviar emails reales (reusa SENDGRID_API_KEY/_FROM_EMAIL/_FROM_NAME de arriba).
# NOTIFICATIONS_CHANNEL=SendGrid

# --- Frontends (Next.js, build-time: van como --build-arg al dockerizar, no runtime) ---
# Google Maps (customer-web, merchant-web y courier-web comparten key y Map ID).
#   Credenciales: https://console.cloud.google.com/google/maps-apis/credentials
#   APIs a activar en Google Cloud: SOLO "Maps JavaScript API" (incluye las librerias
#   marker y geometry). No se usan Places, Geocoding ni Routes.
#   Restringe la key por HTTP referrer: http://localhost:3000/*, :3001/*, :3002/* y el dominio de prod.
#   Sin key los mapas muestran "Mapa no disponible" y el resto funciona.
GOOGLE_MAPS_API_KEY=
# Map ID (Map Management, vector). Vacio = DEMO_MAP_ID, valido SOLO en desarrollo.
#   https://console.cloud.google.com/google/maps-apis/studio/maps
GOOGLE_MAPS_MAP_ID=
# Legado (solo courier-web; se usan si GOOGLE_MAPS_* esta vacia). Preferir las de arriba.
# COURIER_GOOGLE_MAPS_API_KEY=
# COURIER_GOOGLE_MAPS_MAP_ID=
# Customer: Stripe publishable key (no es secreta, se expone al cliente por diseno).
#   https://dashboard.stripe.com/test/apikeys
CUSTOMER_STRIPE_PUBLISHABLE_KEY=
