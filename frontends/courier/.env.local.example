# Rappix Courier — local environment
# Copy to .env.local and adjust. Never commit .env.local.

# API Gateway (YARP). All requests go here, never to individual services.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps key — required to render the active delivery map.
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API").
# Restrict the key to http://localhost:3002/* in dev and to the production origin later.
# If left empty, the app renders a placeholder instead of the map (the rest works).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for a custom styled (vector) map. Create one at
# https://console.cloud.google.com/google/maps-apis/studio/maps. Low-saturation,
# subtle palette recommended (use a Light / Minimal preset and tweak).
# If empty, Google's default style is used.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Default map center when the courier hasn't reported a location yet.
# Centered on Santo Domingo (matches the merchant/customer defaults).
NEXT_PUBLIC_DEFAULT_LAT=18.4719
NEXT_PUBLIC_DEFAULT_LNG=-69.9000
