# Rappix Merchant — local environment
# Copy to .env.local and adjust.

# API Gateway (YARP). All requests go here, never to individual services.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps key — required to render the maps (same key as courier/merchant/customer).
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API" — the only Google API the frontends use).
# Restrict the key to http://localhost:3001/* in dev and to the production origin later.
# If left empty, the app renders "Mapa no disponible" instead of the map (the rest works).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for a custom styled (vector) map. Create one at
# https://console.cloud.google.com/google/maps-apis/studio/maps.
# If empty, the dev-only fallback DEMO_MAP_ID is used (production needs a real Map ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Default map center when the merchant hasn't picked a pickup location yet.
# Centered on Santo Domingo.
NEXT_PUBLIC_DEFAULT_LAT=18.4719
NEXT_PUBLIC_DEFAULT_LNG=-69.9000
