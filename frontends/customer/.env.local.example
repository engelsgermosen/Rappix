# Rappix Customer — local environment
# Copy to .env.local and adjust.

# API Gateway (YARP). All requests go here, never to individual services.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Stripe publishable key (placeholder). Payments service in Phase 8 is
# event-driven and DOES NOT expose a PaymentIntent endpoint — we render
# a method picker instead of Stripe Elements until the backend ships it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Default delivery point used at quote time. Merchants does not expose
# pickup coords today, so the FE sends a constant distanceKm (~2.5).
NEXT_PUBLIC_DEFAULT_LAT=18.4719
NEXT_PUBLIC_DEFAULT_LNG=-69.9000
NEXT_PUBLIC_DEFAULT_DISTANCE_KM=2.5
