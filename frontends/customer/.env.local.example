# Rappix Customer — local environment
# Copy to .env.local and adjust.

# API Gateway (YARP). All requests go here, never to individual services.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps key — required to render the maps (same key as courier/merchant/customer).
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API" — the only Google API the frontends use).
# Restrict the key to http://localhost:3000/* in dev and to the production origin later.
# If left empty, the app renders "Mapa no disponible" instead of the map (the rest works).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for a custom styled (vector) map. Create one at
# https://console.cloud.google.com/google/maps-apis/studio/maps.
# If empty, the dev-only fallback DEMO_MAP_ID is used (production needs a real Map ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Stripe publishable key (placeholder). Payments service in Phase 8 is
# event-driven and DOES NOT expose a PaymentIntent endpoint — we render
# a method picker instead of Stripe Elements until the backend ships it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Default delivery point used at quote time. Merchants does not expose
# pickup coords today, so the FE sends a constant distanceKm (~2.5).
NEXT_PUBLIC_DEFAULT_LAT=18.4719
NEXT_PUBLIC_DEFAULT_LNG=-69.9000
NEXT_PUBLIC_DEFAULT_DISTANCE_KM=2.5
